{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "//": [
    "cSpell bundles csharp/dotnet/npm/bash dictionaries but only auto-enables them for",
    "matching languageIds. This repo is almost entirely Markdown ABOUT code, so they are",
    "enabled globally here — that alone clears most .NET terms (nameof, netstandard, ...).",
    "`words` below is only for product names no dictionary carries.",
    "Language is en (US) deliberately: rules/communication-style.md mandates US English,",
    "so en-gb is NOT enabled — 'behaviour'/'defence' should be flagged, not whitelisted."
  ],
  "dictionaries": [
    "csharp",
    "dotnet",
    "typescript",
    "node",
    "npm",
    "bash",
    "softwareTerms",
    "filetypes",
    "companies"
  ],
  "words": [
    "antipatterns",
    "appsettings",
    "Araújo",
    "AutoFixture",
    "AutoNSubstitute",
    "Bogus",
    "bursty",
    "catastrophizing",
    "configureawait",
    "CSharpier",
    "csproj",
    "Dapper",
    "desyncs",
    "Dockerfiles",
    "Drizzle",
    "ErrorOr",
    "exfiltration",
    "frontmatter",
    "fsproj",
    "graphify",
    "Grok",
    "Grokking",
    "HSTS",
    "Infracost",
    "Interruptible",
    "ints",
    "Liskov",
    "llms",
    "Mapperly",
    "Mediat",
    "MediatR",
    "NACL",
    "NACLs",
    "negotiables",
    "Neon",
    "neonctl",
    "neondatabase",
    "netstandard",
    "Npgsql",
    "NSubstitute",
    "Nuno",
    "opencode",
    "Ponytail",
    "postamble",
    "Postgres",
    "PostgreSqlContainer",
    "PostgREST",
    "Rego",
    "replayable",
    "Roslynator",
    "Scalar",
    "Serilog",
    "shadcn",
    "Shouldly",
    "slnx",
    "supabase",
    "Terratest",
    "Testcontainers",
    "tfsec",
    "tftest",
    "tftpl",
    "tfvars",
    "undebuggable",
    "Ungated",
    "unparameterized",
    "unreviewed",
    "Valkey",
    "vbproj",
    "VersionOverride",
    "Wolverine",
    "WolverineFx",
    "Zustand"
  ],
  "ignoreRegExpList": [
    "/`[^`\\n]*`/",
    "/```[\\s\\S]*?```/",
    "/https?:\\/\\/\\S+/"
  ],
  "ignorePaths": [
    ".git/**",
    "node_modules/**",
    "third-party/**",
    "presets/**/.claude/**"
  ]
}
